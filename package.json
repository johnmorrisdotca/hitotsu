{
  "name": "@johnmorrisdotca/hitotsu",
  "version": "1.3.2",
  "description": "Hitotsu, a colour-card shedding game for two to eight: the familiar play, the popular house rules as options, a computer player, a table for several devices, and its own deck. Zero dependencies.",
  "license": "MIT",
  "author": "John Morris",
  "homepage": "https://johnmorrisdotca.github.io/hitotsu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/hitotsu.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/hitotsu/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "keywords": [
    "accessible-cards",
    "bot-player",
    "browser",
    "bun",
    "call-last-card",
    "card-deck",
    "card-game",
    "card-game-ai",
    "card-game-engine",
    "card-game-rules",
    "card-sounds",
    "cli",
    "color-card-game",
    "colour-card-game",
    "command-line",
    "computer-opponent",
    "computer-player",
    "crazy-eights",
    "custom-element",
    "deck-design",
    "deno",
    "draw-two",
    "english",
    "esm",
    "family-game",
    "game-bot",
    "game-engine",
    "game-notation",
    "game-rules",
    "hitotsu-table",
    "house-rules",
    "i18n",
    "japanese",
    "jump-in",
    "multiplayer",
    "multiplayer-card-game",
    "no-dependencies",
    "node",
    "one-card-left",
    "party-game",
    "react",
    "replayable",
    "reverse",
    "rules-engine",
    "saved-game",
    "seeded-random",
    "seeded-shuffle",
    "seven-zero",
    "sevens-and-zeros",
    "shedding-game",
    "skip",
    "sound-effects",
    "stacking-draw-cards",
    "svg",
    "svg-cards",
    "tabletop",
    "turn-based-game",
    "typescript",
    "web-component",
    "wild-draw-four",
    "zero-dependencies"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    },
    "./element-define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    },
    "./card-sounds": {
      "types": "./dist/card-sounds.d.ts",
      "import": "./dist/card-sounds.js",
      "default": "./dist/card-sounds.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CREDITS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "site": "pnpm build && node scripts/site.mjs",
    "sounds": "node scripts/sounds.mjs",
    "docs:make": "node scripts/docs.mjs",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "prepublishOnly": "pnpm check && pnpm build",
    "test:cli": "pnpm build && node scripts/check-cli.mjs",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "test:demo": "pnpm site && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "bin": {
    "hitotsu": "bin/hitotsu.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0"
}
